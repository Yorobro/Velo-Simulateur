{% extends 'layout/base.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block titre %}Historique des trajets{% endblock %}
{% block sous_titre %}<div class="sous-titre">{{ page.total|nombre }} trajet{{ page.total > 1 ? 's' }} au total</div>{% endblock %}

{% block contenu %}
<div class="carte">
  {% if page.elements is empty %}
    {{ ui.vide('horloge', 'Aucun trajet', 'Vos trajets apparaîtront ici après votre premier emprunt.') }}
  {% else %}
    <div class="table-conteneur">
      <table class="table">
        <thead><tr><th>Départ</th><th>Trajet</th><th>Vélo</th><th>Formule</th><th class="num">Durée</th><th class="num">Montant</th><th>Statut</th></tr></thead>
        <tbody>
        {% for l in page.elements %}
          <tr>
            <td>{{ l.date_heure_depart|date_fr }}</td>
            <td><div class="etapes">{{ l.station_depart }} <span class="fleche">{{ icone('fleche', 14) }}</span> {{ l.station_arrivee ?? '…' }}</div></td>
            <td>n° {{ l.id_velo }} {{ ui.type_velo(l.type_velo) }}{% if l.avec_casque %} <small>+ casque</small>{% endif %}</td>
            <td>{{ l.formule }}</td>
            <td class="num">{{ l.duree_min|duree }}</td>
            <td class="num">{{ l.montant|euros }}</td>
            <td>
              {% if l.statut == 'EN_COURS' %}{{ ui.badge('EN_COURS') }}
              {% elseif l.montant == 0 %}<span class="badge badge-neutral">Gratuit</span>
              {% else %}{{ ui.badge(l.date_reglement ? 'PAYEE' : 'A_PAYER') }}{% endif %}
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
    {{ ui.pagination(page) }}
  {% endif %}
</div>
{% endblock %}
