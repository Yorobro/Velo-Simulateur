{% extends 'layout/auth.html.twig' %}
{% import 'components/ui.html.twig' as ui %}

{% block titre %}Inscription{% endblock %}

{% block contenu %}
  <h1>Créer un compte</h1>
  <p>Inscrivez-vous, choisissez une formule et empruntez votre premier vélo.</p>
  <form method="post" action="/inscription">
    {{ ui.csrf() }}
    <div class="form-grille">
      <div class="groupe">
        <label for="prenom">Prénom</label>
        <input class="champ" id="prenom" name="prenom" required maxlength="50" autocomplete="given-name" value="{{ saisie.prenom ?? '' }}">
      </div>
      <div class="groupe">
        <label for="nom">Nom</label>
        <input class="champ" id="nom" name="nom" required maxlength="50" autocomplete="family-name" value="{{ saisie.nom ?? '' }}">
      </div>
      <div class="groupe plein">
        <label for="email">Adresse e-mail</label>
        <input class="champ" id="email" name="email" type="email" required maxlength="254" autocomplete="email" value="{{ saisie.email ?? '' }}">
      </div>
      <div class="groupe plein">
        <label for="telephone">Téléphone</label>
        <input class="champ" id="telephone" name="telephone" required autocomplete="tel" placeholder="06 12 34 56 78" value="{{ saisie.telephone ?? '' }}">
      </div>
      <div class="groupe">
        <label for="mot_de_passe">Mot de passe</label>
        <input class="champ" id="mot_de_passe" name="mot_de_passe" type="password" required minlength="8" autocomplete="new-password">
        <div class="aide">8 caractères au minimum.</div>
      </div>
      <div class="groupe">
        <label for="confirmation">Confirmation</label>
        <input class="champ" id="confirmation" name="confirmation" type="password" required minlength="8" autocomplete="new-password">
      </div>
    </div>
    <button class="btn btn-bloc" type="submit" style="margin-top: 18px">Créer mon compte</button>
  </form>
  <p class="muted" style="margin-top: 20px">Déjà inscrit ? <a href="/connexion">Se connecter</a></p>
{% endblock %}
